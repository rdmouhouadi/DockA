# =============================================================================
# DocKA — Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is never committed to git.
# =============================================================================


# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=docka
POSTGRES_PASSWORD=docka
POSTGRES_DB=docka_app

# Airflow uses a separate database on the same PostgreSQL instance
POSTGRES_AIRFLOW_DB=docka_airflow


# -----------------------------------------------------------------------------
# Elasticsearch
# -----------------------------------------------------------------------------

ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# Set to true if your Elasticsearch requires authentication (not needed for local dev)
ELASTICSEARCH_AUTH_ENABLED=false
# ELASTICSEARCH_USER=elastic
# ELASTICSEARCH_PASSWORD=changeme


# -----------------------------------------------------------------------------
# Airflow
# -----------------------------------------------------------------------------

# Secret key for Airflow session signing — change this in production
AIRFLOW__WEBSERVER__SECRET_KEY=docka-dev-secret-change-in-prod

# Airflow database connection (auto-built from Postgres vars above in most setups)
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://docka:docka@postgres/docka_airflow

# Celery broker (Redis)
AIRFLOW__CELERY__BROKER_URL=redis://redis:6379/0
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://docka:docka@postgres/docka_airflow

# Parallelism — reduce for local development to avoid OOM kills
AIRFLOW__CORE__PARALLELISM=4
AIRFLOW__CORE__MAX_ACTIVE_TASKS_PER_DAG=2

# Admin credentials
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@docka.local


# -----------------------------------------------------------------------------
# pgAdmin
# -----------------------------------------------------------------------------

PGADMIN_DEFAULT_EMAIL=admin@docka.local
PGADMIN_DEFAULT_PASSWORD=admin


# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------

API_HOST=0.0.0.0
API_PORT=8000


# -----------------------------------------------------------------------------
# UI
# -----------------------------------------------------------------------------

# URL the Streamlit UI uses to reach the FastAPI backend
# Inside Docker: http://api:8000
# Outside Docker (local dev): http://localhost:8000
API_BASE_URL=http://api:8000


# -----------------------------------------------------------------------------
# Ingestion
# -----------------------------------------------------------------------------

# Root path for document storage (mounted into containers)
DATA_ROOT=/data

# Default source tag for filesystem ingestion
DEFAULT_SOURCE=sample

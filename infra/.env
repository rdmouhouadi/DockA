# =============================================================================
# DocKA — Infra Environment Variables
# =============================================================================

# Database
POSTGRES_HOST=postgres
POSTGRES_USER=docka
POSTGRES_PASSWORD=docka
POSTGRES_DB=docka_app

# Airflow admin user
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# Airflow webserver session secret
AIRFLOW__WEBSERVER__SECRET_KEY=docka_secret_change_in_prod

# Airflow UID
AIRFLOW_UID=50000

# Elasticsearch
ELASTICSEARCH_HOST=http://elasticsearch:9200
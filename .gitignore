# =============================================================================
# DocKA — .gitignore
# =============================================================================

# Environment variables — never commit secrets
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/

# Python version managers
.python-version

# Virtual environments
.venv/
venv/
env/
ENV/

# pytest
.pytest_cache/
.coverage
htmlcov/

# IDEs
.vscode/
.idea/
*.iml

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Desktop.ini

# Data — never commit documents or uploads
data/samples/
data/uploads/

# Logs
*.log
logs/

# Docker volumes (if accidentally created locally)
postgres_data/
elasticsearch_data/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Airflow
airflow/logs/
airflow/plugins/
